    "/api/v1/search/jira": {
      "post": {
        "summary": "Search Jira issues",
        "description": "Execute a JQL search to find Jira tickets. Returns ticket summaries and links.",
        "operationId": "search_jira_api_v1_search_jira_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The search keywords (e.g. 'missed campaigns'). DO NOT write JQL. Provide only plain text keywords. The system will format it."
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
